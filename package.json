{
  "name": "copilot-contingent-watcher",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "m3-13",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m3-13/vsc-contingent-watcher"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "copilot",
    "quota",
    "premium requests",
    "usage",
    "budget"
  ],
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "contingent-level-4": {
        "description": "Copilot Contingent: plenty left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "contingent-level-3": {
        "description": "Copilot Contingent: three quarters left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "contingent-level-2": {
        "description": "Copilot Contingent: half left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E003"
        }
      },
      "contingent-level-1": {
        "description": "Copilot Contingent: running low",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E004"
        }
      },
      "contingent-level-0": {
        "description": "Copilot Contingent: empty or exhausted",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E005"
        }
      },
      "contingent-battery-4": {
        "description": "Copilot Contingent battery: plenty left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E006"
        }
      },
      "contingent-battery-3": {
        "description": "Copilot Contingent battery: three quarters left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E007"
        }
      },
      "contingent-battery-2": {
        "description": "Copilot Contingent battery: half left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E008"
        }
      },
      "contingent-battery-1": {
        "description": "Copilot Contingent battery: running low",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E009"
        }
      },
      "contingent-battery-0": {
        "description": "Copilot Contingent battery: empty or exhausted",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00A"
        }
      },
      "contingent-ring-4": {
        "description": "Copilot Contingent ring: plenty left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00B"
        }
      },
      "contingent-ring-3": {
        "description": "Copilot Contingent ring: three quarters left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00C"
        }
      },
      "contingent-ring-2": {
        "description": "Copilot Contingent ring: half left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00D"
        }
      },
      "contingent-ring-1": {
        "description": "Copilot Contingent ring: running low",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00E"
        }
      },
      "contingent-ring-0": {
        "description": "Copilot Contingent ring: empty or exhausted",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E00F"
        }
      },
      "contingent-bars-4": {
        "description": "Copilot Contingent bars: plenty left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E010"
        }
      },
      "contingent-bars-3": {
        "description": "Copilot Contingent bars: three quarters left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E011"
        }
      },
      "contingent-bars-2": {
        "description": "Copilot Contingent bars: half left",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E012"
        }
      },
      "contingent-bars-1": {
        "description": "Copilot Contingent bars: running low",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E013"
        }
      },
      "contingent-bars-0": {
        "description": "Copilot Contingent bars: empty or exhausted",
        "default": {
          "fontPath": "media/contingent-icons.woff",
          "fontCharacter": "\\E014"
        }
      }
    },
    "commands": [
      {
        "command": "contingentWatcher.refresh",
        "title": "%cmd.refresh%",
        "category": "Copilot Contingent",
        "icon": "$(refresh)"
      },
      {
        "command": "contingentWatcher.showDetails",
        "title": "%cmd.showDetails%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.showTips",
        "title": "%cmd.showTips%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.signIn",
        "title": "%cmd.signIn%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.snooze",
        "title": "%cmd.snooze%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.showLog",
        "title": "%cmd.showLog%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.configureBillingToken",
        "title": "%cmd.configureBillingToken%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.btw",
        "title": "%cmd.btw%",
        "category": "Copilot Contingent"
      },
      {
        "command": "contingentWatcher.btw.show",
        "title": "%cmd.btwShow%",
        "category": "Copilot Contingent"
      }
    ],
    "chatParticipants": [
      {
        "id": "contingentWatcher.btw",
        "name": "btw",
        "fullName": "btw",
        "description": "%chat.btw.description%",
        "isSticky": false
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contingentWatcher",
          "title": "%view.container%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "contingentWatcher": [
        {
          "type": "webview",
          "id": "contingentWatcher.dashboard",
          "name": "%view.dashboard%",
          "icon": "media/activitybar.svg",
          "contextualTitle": "%view.container%"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Contingent Watcher",
      "properties": {
        "contingentWatcher.auth.provider": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "github-enterprise"
          ],
          "enumDescriptions": [
            "%cfg.authProvider.auto%",
            "%cfg.authProvider.github%",
            "%cfg.authProvider.enterprise%"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.authProvider%"
        },
        "contingentWatcher.auth.apiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.apiUrl%"
        },
        "contingentWatcher.refreshIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 120,
          "markdownDescription": "%cfg.refreshIntervalMinutes%"
        },
        "contingentWatcher.statusBar.display": {
          "type": "string",
          "enum": [
            "remaining",
            "used",
            "percent",
            "dailyBudget"
          ],
          "enumDescriptions": [
            "%cfg.display.remaining%",
            "%cfg.display.used%",
            "%cfg.display.percent%",
            "%cfg.display.dailyBudget%"
          ],
          "default": "remaining",
          "markdownDescription": "%cfg.display%"
        },
        "contingentWatcher.statusBar.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "markdownDescription": "%cfg.alignment%"
        },
        "contingentWatcher.warnings.thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "default": [
            50,
            75,
            90,
            100
          ],
          "markdownDescription": "%cfg.thresholds%"
        },
        "contingentWatcher.warnings.paceWarning": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.paceWarning%"
        },
        "contingentWatcher.warnings.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.warningsEnabled%"
        },
        "contingentWatcher.budget.countWeekends": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.countWeekends%"
        },
        "contingentWatcher.budget.reserve": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%cfg.reserve%"
        },
        "contingentWatcher.tips.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.tipsEnabled%"
        },
        "contingentWatcher.appearance.accentColor": {
          "type": "string",
          "default": "auto",
          "examples": [
            "auto",
            "teal",
            "violet",
            "blue",
            "green",
            "orange",
            "pink",
            "#ff8800"
          ],
          "pattern": "^(auto|teal|violet|blue|green|orange|pink|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$",
          "markdownDescription": "%cfg.accentColor%"
        },
        "contingentWatcher.statusBar.icon": {
          "type": "string",
          "enum": [
            "gauge",
            "battery",
            "ring",
            "bars",
            "none"
          ],
          "enumDescriptions": [
            "%cfg.icon.gauge%",
            "%cfg.icon.battery%",
            "%cfg.icon.ring%",
            "%cfg.icon.bars%",
            "%cfg.icon.none%"
          ],
          "default": "gauge",
          "markdownDescription": "%cfg.statusBarIcon%"
        },
        "contingentWatcher.statusBar.color": {
          "type": "string",
          "default": "auto",
          "examples": [
            "auto",
            "teal",
            "violet",
            "blue",
            "green",
            "orange",
            "pink",
            "#ff8800"
          ],
          "pattern": "^(auto|teal|violet|blue|green|orange|pink|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$",
          "markdownDescription": "%cfg.statusBarColor%"
        },
        "contingentWatcher.warnings.surplusHint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.surplusHint%"
        },
        "contingentWatcher.activity.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.activity%"
        },
        "contingentWatcher.chat.preferredModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "gpt-5-mini",
            "gpt-4.1",
            "gpt-4o"
          ],
          "markdownDescription": "%cfg.preferredModels%"
        },
        "contingentWatcher.btw.includeChat": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.btwIncludeChat%"
        },
        "contingentWatcher.btw.model": {
          "type": "string",
          "enum": [
            "chat",
            "included"
          ],
          "enumDescriptions": [
            "%cfg.btwModel.chat%",
            "%cfg.btwModel.included%"
          ],
          "default": "chat",
          "markdownDescription": "%cfg.btwModel%"
        },
        "contingentWatcher.unit": {
          "type": "string",
          "enum": [
            "auto",
            "credits",
            "requests"
          ],
          "enumDescriptions": [
            "%cfg.unit.auto%",
            "%cfg.unit.credits%",
            "%cfg.unit.requests%"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.unit%"
        },
        "contingentWatcher.btw.openIn": {
          "type": "string",
          "enum": [
            "side",
            "window"
          ],
          "enumDescriptions": [
            "%cfg.btwOpenIn.side%",
            "%cfg.btwOpenIn.window%"
          ],
          "default": "side",
          "markdownDescription": "%cfg.btwOpenIn%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "contingentWatcher.gettingStarted",
        "title": "%walk.title%",
        "description": "%walk.description%",
        "steps": [
          {
            "id": "signIn",
            "title": "%walk.signIn.title%",
            "description": "%walk.signIn.description%",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:contingentWatcher.signIn"
            ]
          },
          {
            "id": "statusBar",
            "title": "%walk.statusBar.title%",
            "description": "%walk.statusBar.description%",
            "media": {
              "markdown": "media/walkthrough/statusbar.md"
            },
            "completionEvents": [
              "onCommand:contingentWatcher.showDetails"
            ]
          },
          {
            "id": "saveRequests",
            "title": "%walk.save.title%",
            "description": "%walk.save.description%",
            "media": {
              "markdown": "media/walkthrough/best-practices.md"
            },
            "completionEvents": [
              "onCommand:contingentWatcher.showTips"
            ]
          },
          {
            "id": "configure",
            "title": "%walk.configure.title%",
            "description": "%walk.configure.description%",
            "media": {
              "markdown": "media/walkthrough/configure.md"
            },
            "completionEvents": [
              "onSettingChanged:contingentWatcher"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "contingentWatcher.btw",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
